{
  "schema_version": "orchestrate-agent-work.exec-plan.v2",
  "source_package": "orchestrate-agent-work",
  "loop_type": "build-repair",
  "objective": "Bestehende manuelle Aussparungen direkt verschieben, Ecken frei verziehen und metrisch bearbeiten, mit Entwurfsschutz und Undo.",
  "authorization": "Nutzer 19.10.2026: Aussparungen ordentlich verschieben, verziehen, bearbeiten, ohne jedes Mal löschen. Lokal, kein Push/Deploy.",
  "budget": {
    "max_parallel_agents": 2,
    "max_total_agent_tasks": 6,
    "max_repair_rounds": 3
  },
  "evidence_decision": {
    "evidence_needed": true,
    "reason_codes": [
      "professional_practice",
      "design_decision"
    ],
    "freshness": "current",
    "route": "research-phase",
    "artifact": "docs/aussparungen-2026-10-19/evidence.json"
  },
  "tasks": [
    {
      "task_id": "research",
      "kind": "professional_practice_research",
      "agent": "primary",
      "depends_on": [],
      "risk": "read_only",
      "gate": "internal",
      "inputs": [
        "Nutzerauftrag, bestehende Geometrie, direkt geöffnete Adobe-Primärquelle"
      ],
      "outputs": [
        "docs/aussparungen-2026-10-19/evidence.json"
      ],
      "checks": [
        "Objektauswahl und Ankerpunkte als etablierte Bearbeitungsinteraktion"
      ],
      "max_repairs": 3,
      "stop_condition": "PASS oder fehlende Evidence"
    },
    {
      "task_id": "contract",
      "kind": "evidence_compaction",
      "agent": "primary",
      "depends_on": [
        "research"
      ],
      "risk": "read_only",
      "gate": "internal",
      "inputs": [
        "SPEC, HindernisM, vorhandene Entwurfsnavigation, evidence.json"
      ],
      "outputs": [
        "SPEC Bedienvertrag",
        "docs/aussparungen-2026-10-19/evidence.json"
      ],
      "checks": [
        "Freie Konturen verwenden bestehendes Engineformat; Gauben bleiben gekoppelt"
      ],
      "max_repairs": 3,
      "stop_condition": "PASS oder konkrete Scope-/Evidence-Verletzung"
    },
    {
      "task_id": "implementation",
      "kind": "implementation",
      "agent": "primary",
      "depends_on": [
        "contract"
      ],
      "risk": "internal_reversible",
      "gate": "internal",
      "inputs": [
        "Vertrag, Homographie, Entwurfsschutz, genaue Polygonprüfung"
      ],
      "outputs": [
        "Aussparungseditor mit Vorschau und genauer Kontur"
      ],
      "checks": [
        "Auswahl, Bewegung, freie Ecken, Maßfelder, Vorschau und atomare Übernahme"
      ],
      "max_repairs": 3,
      "stop_condition": "PASS oder derselbe Fehler zweimal ohne Fortschritt"
    },
    {
      "task_id": "qa",
      "kind": "deterministic_qa",
      "agent": "primary",
      "depends_on": [
        "implementation"
      ],
      "risk": "internal_reversible",
      "gate": "internal",
      "inputs": [
        "Aktueller Arbeitsstand"
      ],
      "outputs": [
        "Tests, Typprüfung, statischer Build, Desktop-/Tablet-/Mobile-Captures"
      ],
      "checks": [
        "Geometrie, Integration, Desktop/Mobile/Touch, Undo/Reload, Typen und Build"
      ],
      "max_repairs": 3,
      "stop_condition": "PASS oder drei Reparaturrunden je Defektklasse"
    },
    {
      "task_id": "review",
      "kind": "independent_review",
      "agent": "aussparung_review",
      "depends_on": [
        "qa"
      ],
      "risk": "read_only",
      "gate": "internal",
      "inputs": [
        "Diff, Vertrag, Testergebnisse und Screenshots"
      ],
      "outputs": [
        "Unabhängige Befunde"
      ],
      "checks": [
        "Keine offenen Blocker oder Majors; vorhandene Nutzeränderungen bewahrt"
      ],
      "max_repairs": 3,
      "stop_condition": "PASS oder konkrete verbleibende Grenze"
    }
  ]
}

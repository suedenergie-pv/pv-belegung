{
  "name": "pv-belegung",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "build:pages": "node scripts/build-pages.mjs",
    "build:vps": "node scripts/build-pages.mjs --target=vps",
    "preview:vps": "node scripts/serve-pages.mjs --target=vps",
    "test:vps": "node scripts/test-pages.mjs --target=vps",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "kalibrierung": "npm run kalibrierung -w @pv-belegung/engine"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
